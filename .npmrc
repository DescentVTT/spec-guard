# npx and npm exec fetch nothing here. Where a command is not installed - a
# fresh clone, a worktree before `npm ci` - npm stops and names the package
# it would have downloaded, where it would otherwise run whatever the
# registry has under that name, unasked when no terminal is attached.
# Installs and scripts do not read this key. A package an earlier npx left
# in npm's cache still runs, and `--yes` on a command undoes the line, so
# nothing here passes it (tests/npm.test.ts).
yes=false
